# The stack the integration suite runs against is built from these exact commits of the ristik forks (tests/integration/support/build-images.sh); no prebuilt
# image is pulled and nothing is published. The aggregator's go.mod pins bft-core at BFT_CORE_SHA, so the root and the aggregator speak the same GetTrustBase wire.
BFT_CORE_REPO=https://github.com/ristik/bft-core.git
BFT_CORE_SHA=12f16641d74f19e8e9df823a9867a6313e322e10
AGGREGATOR_REPO=https://github.com/ristik/aggregator-go.git
AGGREGATOR_SHA=3710e0403b9ec79a686893c68c262a68dac974e7
