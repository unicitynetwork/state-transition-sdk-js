        "networkId": 3,
        "partitionId": 7,
        "shardId": "",
        "rootRound": "16",
        "sealTimestampSeconds": "1731504150",
        "rootEpoch": "1",
        "shardRound": "14",
        "shardEpoch": "0",
        "stateRoot": "7e9f358e96811c556061a484c6691f74dc3845f0ba7c758fca91785d5f576423"
      },
      "checkpoint": {
        "networkId": 3,
        "requiredRootRound": "16"
      },
      "decision": "accept",
      "note": "the requirement equals the snapshot round: accepted (the comparison is not strict)"
    },
