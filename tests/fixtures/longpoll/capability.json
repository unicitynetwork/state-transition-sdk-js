{
  "note": "Client behavior for a LOCALLY VALIDATED latest get_inclusion_proofs.v1 request which carried waitMs. 'retry' means exactly one retry of the same request without waitMs (all other params preserved), within the same overall deadline; the second outcome is final and the choice is kept for the rest of the operation.",
  "cases": [
    {
      "name": "strict-parser-generic-malformed-params",
      "response": {
        "error": {
          "code": -32602,
          "message": "Invalid params",
          "data": {
            "reason": "invalid_request",
            "detail": "malformed_params",
            "retryable": false
          }
        }
      },
      "action": "retry",
      "note": "No field name is present or required."
    },
    {
      "name": "malformed-params-with-echo",
      "response": {
        "error": {
          "code": -32602,
          "message": "Invalid params",
          "data": {
            "reason": "invalid_request",
            "detail": "malformed_params",
            "retryable": false,
            "waitedMs": 0
          }
        }
      },
      "action": "propagate",
      "note": "The echo proves the server parsed waitMs: never retry without it. Only the bare generic shape (no data.waitedMs) triggers the retry."
    },
    {
      "name": "retry-fails-again",
      "first": "as above",
      "second": {
        "error": {
